generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PREMIUM
}

enum EntityType {
  ARTWORK
  ARTIST
  ARTICLE
  CONCEPT
  MOVEMENT
  PERIOD
  TEXT
  PLACE
}

enum EntityStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum ContentLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum MediaKind {
  IMAGE
}

enum MediaProvider {
  WIKIMEDIA_COMMONS
  WIKIPEDIA
  MUSEUM
  IIIF
  OPENVERSE
  UNKNOWN
}

enum MediaQualityTier {
  LOW
  MEDIUM
  HIGH
  MASTER
}

enum MediaOriginType {
  EXTERNAL_URL
  UPLOAD
  INGESTED
}

enum MediaRole {
  PRIMARY_LEGACY
  HERO
  CARD
  DETAIL
  THUMBNAIL
  EXPLORER_3D
  GALLERY
}

enum MediaDisplayMode {
  COVER
  CONTAIN
}

enum SourceType {
  BOOK
  ARTICLE
  WEBSITE
  CATALOG
  PAPER
}

enum HomeDeckSurface {
  HOME
  RECOMMENDED
}

model Entity {
  id           String        @id @default(cuid())
  type         EntityType
  title        String
  slug         String        @unique
  summary      String?
  content      String?
  contentLevel ContentLevel?
  status       EntityStatus  @default(DRAFT)

  startYear Int?
  endYear   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Graph
  outgoing Relation[] @relation("outgoing")
  incoming Relation[] @relation("incoming")

  // Media (1..n)
  mediaLinks EntityMedia[]

  // Sources
  sourceRefs SourceRef[]

  // Internal notes
  curatorNotes CuratorNote[]

  // Collaborators / contributors
  contributors Contributor[]

  // Saved by users
  savedBy SavedEntity[]

  // Collections
  collectionItems CollectionEntity[]

  // Editorial home decks
  homeDeckItems HomeDeckItem[]

  // Taxonomy
  tags EntityTag[]

  // Editorial translations
  translations EntityTranslation[]

  // Type-specific details (1..1, optional)
  artwork ArtworkDetails?
  artist  ArtistDetails?
  concept ConceptDetails?
  period  PeriodDetails?
}

model EntityTranslation {
  id               String   @id @default(cuid())
  entityId         String
  locale           String
  title            String
  shortDescription String?
  essay            String?
  notes            String?
  excerpt          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, locale])
  @@index([entityId])
  @@index([locale])
}

model Relation {
  id            String  @id @default(cuid())
  fromId        String
  toId          String
  type          String // "CREATED_BY", "REPRESENTS_CONCEPT", ...
  relationTypeId String?
  weight        Float?
  justification String?

  from Entity @relation("outgoing", fields: [fromId], references: [id])
  to   Entity @relation("incoming", fields: [toId], references: [id])
  relationType RelationType? @relation(fields: [relationTypeId], references: [id])

  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@index([relationTypeId])
}

model RelationType {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  inverseLabel String?
  directed     Boolean  @default(true)
  category     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  relations Relation[]
  translations RelationTypeTranslation[]
}

model RelationTypeTranslation {
  id             String   @id @default(cuid())
  relationTypeId String
  locale         String
  label          String
  inverseLabel   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  relationType RelationType @relation(fields: [relationTypeId], references: [id], onDelete: Cascade)

  @@unique([relationTypeId, locale])
  @@index([locale])
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities EntityTag[]
  translations TagTranslation[]

  @@index([category])
  @@index([isActive])
}

model TagTranslation {
  id          String   @id @default(cuid())
  tagId       String
  locale      String
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale])
}

model EntityTag {
  entityId String
  tagId    String
  weight   Float?
  source   String?
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityId, tagId])
  @@index([entityId])
  @@index([tagId])
  @@index([source])
}

model Media {
  id   String    @id @default(cuid())
  url  String
  kind MediaKind @default(IMAGE)
  originType MediaOriginType @default(EXTERNAL_URL)
  derivedFromMediaId String?

  canonicalUrl String?
  displayUrl   String?
  sourcePageUrl String?
  storageKey   String?
  originalFilename String?
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  focalX       Float?
  focalY       Float?
  isVector     Boolean          @default(false)
  provider     MediaProvider    @default(UNKNOWN)
  qualityTier  MediaQualityTier @default(MEDIUM)

  alt     String?
  source  String? // where it comes from (page/museum/etc)
  photoBy String? // photographer
  license String? // license type

  createdAt DateTime @default(now())

  derivedFromMedia Media?  @relation("MediaDerivation", fields: [derivedFromMediaId], references: [id])
  derivedAssets    Media[] @relation("MediaDerivation")
  entities EntityMedia[]
  collectionCovers Collection[] @relation("CollectionCoverMedia")
  homeDeckCovers HomeDeck[] @relation("HomeDeckCoverMedia")

  @@index([derivedFromMediaId])
}

model EntityMedia {
  id          String            @id @default(cuid())
  entityId    String
  mediaId     String
  role        MediaRole         @default(PRIMARY_LEGACY)
  sortOrder   Int               @default(0)
  isPrimary   Boolean           @default(false)
  displayMode MediaDisplayMode?
  focalX      Float?
  focalY      Float?
  cropExplorer3d Json?
  cropList       Json?
  cropDetail     Json?
  cropPreview    Json?

  entity Entity @relation(fields: [entityId], references: [id])
  media  Media  @relation(fields: [mediaId], references: [id])

  @@index([entityId])
  @@index([mediaId])
  @@index([entityId, role, sortOrder])
  @@index([entityId, isPrimary])
}

model Source {
  id        String     @id @default(cuid())
  type      SourceType
  author    String?
  title     String
  publisher String?
  year      Int?
  url       String?

  createdAt DateTime @default(now())

  refs SourceRef[]
}

model SourceRef {
  id       String @id @default(cuid())
  entityId String
  sourceId String

  page  String?
  quote String?
  note  String?

  entity Entity @relation(fields: [entityId], references: [id])
  source Source @relation(fields: [sourceId], references: [id])

  @@index([entityId])
  @@index([sourceId])
}

model CuratorNote {
  id        String   @id @default(cuid())
  entityId  String
  body      String
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model Contributor {
  id       String @id @default(cuid())
  entityId String

  name String
  role String // curator | advisor | restorer | composer | ...
  note String?

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model ArtworkDetails {
  entityId     String  @id
  authorNation String?

  technique  String?
  materials  String?
  dimensions String?

  location   String? // museum/gallery/current location
  collection String?
  state      String? // restored, destroyed, unfinished...

  entity Entity @relation(fields: [entityId], references: [id])
}

model ArtistDetails {
  entityId String @id

  country   String?
  city      String?
  birthYear Int?
  deathYear Int?

  disciplines String? // simple string list for now
  bioShort    String?
  links       String? // simple string list for now

  entity Entity @relation(fields: [entityId], references: [id])
}

model ConceptDetails {
  entityId   String  @id
  definition String?

  entity Entity @relation(fields: [entityId], references: [id])
}

model PeriodDetails {
  entityId   String  @id
  definition String?

  entity Entity @relation(fields: [entityId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(USER)
  plan         UserPlan @default(FREE)
  isBeta       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedEntities SavedEntity[]
  collections   Collection[]
}

model AppSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedEntity {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}

model Collection {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  notes       String?
  coverMediaId String?
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverMedia Media?             @relation("CollectionCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  items      CollectionEntity[]

  @@unique([userId, name])
  @@index([userId])
  @@index([coverMediaId])
}

model CollectionEntity {
  id           String   @id @default(cuid())
  collectionId String
  entityId     String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entity     Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([collectionId, entityId])
  @@index([collectionId])
  @@index([collectionId, sortOrder])
  @@index([entityId])
  @@index([createdAt])
}

model HomeDeck {
  id           String   @id @default(cuid())
  surface      HomeDeckSurface @default(HOME)
  slug         String   @unique
  title        String
  subtitle     String?
  description  String?
  ctaLabel     String?
  ctaUrl       String?
  ctaRoute     String?
  imageUrl     String?
  imageMediaId String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  imageMedia   Media?                @relation("HomeDeckCoverMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  items        HomeDeckItem[]
  translations HomeDeckTranslation[]

  @@index([surface, isActive, sortOrder])
  @@index([imageMediaId])
}

model HomeDeckTranslation {
  id          String   @id @default(cuid())
  homeDeckId  String
  locale      String
  title       String
  subtitle    String?
  description String?
  ctaLabel    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeDeck HomeDeck @relation(fields: [homeDeckId], references: [id], onDelete: Cascade)

  @@unique([homeDeckId, locale])
  @@index([homeDeckId])
  @@index([locale])
}

model HomeDeckItem {
  id        String   @id @default(cuid())
  deckId    String
  entityId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deck   HomeDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  entity Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([deckId, entityId])
  @@index([deckId])
  @@index([deckId, sortOrder])
  @@index([entityId])
}
