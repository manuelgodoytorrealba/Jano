model ArtistDetailsTranslation {
  id          String   @id @default(cuid())
  entityId    String
  locale      String
  country     String?
  city        String?
  disciplines String?
  bioShort    String?
  links       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  details ArtistDetails @relation(fields: [entityId], references: [entityId], onDelete: Cascade)

  @@unique([entityId, locale])
  @@index([locale])
}

model ConceptDetailsTranslation {
  id         String   @id @default(cuid())
  entityId   String
  locale     String
  definition String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  details ConceptDetails @relation(fields: [entityId], references: [entityId], onDelete: Cascade)

  @@unique([entityId, locale])
  @@index([locale])
}

model PeriodDetailsTranslation {
  id         String   @id @default(cuid())
  entityId   String
  locale     String
  definition String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  details PeriodDetails @relation(fields: [entityId], references: [entityId], onDelete: Cascade)

  @@unique([entityId, locale])
  @@index([locale])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(USER)
  plan         UserPlan @default(FREE)
  isBeta       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedEntities     SavedEntity[]
  collections       Collection[]
  researchDecisions ResearchDecision[]
  ownedResearch     ResearchProject[]  @relation("ResearchProjectOwner")
  archivedResearch  ResearchProject[]  @relation("ResearchProjectArchivedBy")
  researchDraftRevisions ResearchDraftRevision[]
}

model AppSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedEntity {
  id        String   @id @default(cuid())
  userId    String
  entityId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}

model Collection {
  id           String  @id @default(cuid())
  userId       String
  name         String
  description  String?
  notes        String?
  coverMediaId String?
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverMedia Media?             @relation("CollectionCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  items      CollectionEntity[]

  @@unique([userId, name])
  @@index([userId])
  @@index([coverMediaId])
}

model CollectionEntity {
  id           String   @id @default(cuid())
  collectionId String
  entityId     String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entity     Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([collectionId, entityId])
  @@index([collectionId])
  @@index([collectionId, sortOrder])
  @@index([entityId])
  @@index([createdAt])
}

model HomeDeck {
  id           String          @id @default(cuid())
  surface      HomeDeckSurface @default(HOME)
  slug         String          @unique
  title        String
  subtitle     String?
  description  String?
  ctaLabel     String?
  ctaUrl       String?
  ctaRoute     String?
  imageUrl     String?
  imageMediaId String?
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  imageMedia   Media?                @relation("HomeDeckCoverMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  items        HomeDeckItem[]
  translations HomeDeckTranslation[]

  @@index([surface, isActive, sortOrder])
  @@index([imageMediaId])
}

model HomeDeckTranslation {
  id          String   @id @default(cuid())
  homeDeckId  String
  locale      String
  title       String
  subtitle    String?
  description String?
  ctaLabel    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeDeck HomeDeck @relation(fields: [homeDeckId], references: [id], onDelete: Cascade)

  @@unique([homeDeckId, locale])
  @@index([homeDeckId])
  @@index([locale])
}

model HomeDeckItem {
  id        String   @id @default(cuid())
  deckId    String
  entityId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  deck   HomeDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  entity Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([deckId, entityId])
  @@index([deckId])
  @@index([deckId, sortOrder])
  @@index([entityId])
}

model ResearchOutlineSectionExcerpt {
  sectionId        String
  libraryExcerptId String
  sortOrder        Int
  createdAt        DateTime @default(now())

  section        ResearchOutlineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  libraryExcerpt LibraryExcerpt         @relation(fields: [libraryExcerptId], references: [id], onDelete: Cascade)

  @@id([sectionId, libraryExcerptId])
  @@index([libraryExcerptId])
  @@index([sectionId, sortOrder])
}

model ResearchOutlineSectionMaterial {
  sectionId         String
  materialVersionId String
  sortOrder         Int
  createdAt         DateTime @default(now())

  section         ResearchOutlineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  materialVersion LibraryMaterialVersion @relation(fields: [materialVersionId], references: [id], onDelete: Cascade)

  @@id([sectionId, materialVersionId])
  @@index([materialVersionId])
  @@index([sectionId, sortOrder])
}
