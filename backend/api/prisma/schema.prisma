generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PREMIUM
}

enum EntityType {
  ARTWORK
  ARTIST
  ARTICLE
  CONCEPT
  MOVEMENT
  PERIOD
  TEXT
  PLACE
  EVENT
  ORGANIZATION
}

// Canonical graph behaviour. The legacy EntityType remains during the
// incremental migration so existing consumers keep working.
enum KnowledgeEntityKind {
  PERSON
  WORK
  ABSTRACTION
  EVENT
  PLACE
  ORGANIZATION
}

enum KnowledgeAssertionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

enum CitationStance {
  SUPPORTS
  CONTRADICTS
  MENTIONS
}

enum AttributeValueType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  YEAR
  JSON
}

enum EntityStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

enum ContentLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum EntityAliasKind {
  ALTERNATE_TITLE
  COMMON_NAME
  MISSPELLING
  TRANSLITERATION
  NICKNAME
  SEARCH_HINT
}

enum MediaKind {
  IMAGE
}

enum MediaProvider {
  WIKIMEDIA_COMMONS
  WIKIPEDIA
  MUSEUM
  IIIF
  OPENVERSE
  UNKNOWN
}

enum MediaQualityTier {
  LOW
  MEDIUM
  HIGH
  MASTER
}

enum MediaOriginType {
  EXTERNAL_URL
  UPLOAD
  INGESTED
}

enum MediaRole {
  PRIMARY_LEGACY
  HERO
  CARD
  DETAIL
  THUMBNAIL
  EXPLORER_3D
  GALLERY
}

enum MediaDisplayMode {
  COVER
  CONTAIN
}

enum SourceType {
  BOOK
  ARTICLE
  WEBSITE
  CATALOG
  PAPER
}

enum HomeDeckSurface {
  HOME
  RECOMMENDED
}

enum ResearchProjectStatus {
  ACTIVE
  PAUSED
  READY_TO_DECIDE
  ARCHIVED
}

enum ResearchOutlineSectionStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETED
}

enum ResearchFindingStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  POSTPONED
}

enum ResearchDecisionAction {
  INCORPORATE
  REJECT
  POSTPONE
}

enum ResearchJobType {
  PREPARE_SOURCE
  EXTRACT_FINDINGS
  PREPARE_MATERIAL
}

enum ResearchJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ResearchProposalReviewState {
  PENDING
  REVIEWED
  REJECTED
}

enum ResearchFindingProposalType {
  LEGACY
  CLAIM
  ENTITY
  RELATION
}

enum ResearchClaimKind {
  ASSERTION
  CONNECTION_HYPOTHESIS
  CONCEPT
  CONTRADICTION
  OPEN_QUESTION
  SYNTHESIS_STATEMENT
}

enum ResearchClaimStatus {
  DRAFT
  SUPPORTED
  QUESTIONED
  CONTRADICTED
}

enum LibraryMaterialKind {
  TEXT
  URL
  PDF
  IMAGE
  MAP
  BOOK
  FILE
}

enum LibraryMaterialVersionStatus {
  READY
  PENDING_PREPARATION
  FAILED
}

model Entity {
  id           String               @id @default(cuid())
  type         EntityType
  kind         KnowledgeEntityKind?
  title        String
  slug         String               @unique
  summary      String?
  content      String?
  contentLevel ContentLevel?
  status       EntityStatus         @default(DRAFT)

  startYear Int?
  endYear   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Graph
  outgoing Relation[] @relation("outgoing")
  incoming Relation[] @relation("incoming")

  // Media (1..n)
  mediaLinks EntityMedia[]

  // Sources
  sourceRefs SourceRef[]

  // Internal notes
  curatorNotes CuratorNote[]

  // Collaborators / contributors
  contributors Contributor[]

  // Saved by users
  savedBy SavedEntity[]

  // Collections
  collectionItems CollectionEntity[]

  // Editorial home decks
  homeDeckItems HomeDeckItem[]

  // Taxonomy
  tags            EntityTag[]
  classifications EntityClassification[]

  // Canonical editorial assertions and evidence
  attributes         EntityAttribute[]
  citations          Citation[]        @relation("CitationEntity")
  researchPromotions ResearchFinding[] @relation("ResearchFindingPromotedEntity")

  // Editorial translations
  translations EntityTranslation[]
  aliases      EntityAlias[]

  // Type-specific details (1..1, optional)
  artwork          ArtworkDetails?
  artist           ArtistDetails?
  concept          ConceptDetails?
  period           PeriodDetails?
  researchEntities ResearchEntity[]
}

model EntityTranslation {
  id               String   @id @default(cuid())
  entityId         String
  locale           String
  title            String
  shortDescription String?
  essay            String?
  notes            String?
  excerpt          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, locale])
  @@index([entityId])
  @@index([locale])
}

model EntityAlias {
  id        String          @id @default(cuid())
  entityId  String
  locale    String          @default("und")
  value     String
  kind      EntityAliasKind @default(COMMON_NAME)
  weight    Float?
  source    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, locale, kind, value])
  @@index([entityId])
  @@index([locale])
  @@index([kind])
}

model Relation {
  id             String                   @id @default(cuid())
  fromId         String
  toId           String
  relationTypeId String
  weight         Float?
  justification  String?
  status         KnowledgeAssertionStatus @default(DRAFT)
  confidence     Float?
  validFromYear  Int?
  validToYear    Int?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  from         Entity                @relation("outgoing", fields: [fromId], references: [id])
  to           Entity                @relation("incoming", fields: [toId], references: [id])
  relationType RelationType          @relation(fields: [relationTypeId], references: [id])
  translations RelationTranslation[]
  citations    Citation[]            @relation("CitationRelation")

  @@index([fromId])
  @@index([toId])
  @@index([relationTypeId])
}

model RelationTranslation {
  id            String   @id @default(cuid())
  relationId    String
  locale        String
  justification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  relation Relation @relation(fields: [relationId], references: [id], onDelete: Cascade)

  @@unique([relationId, locale])
  @@index([locale])
}

model RelationType {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  inverseLabel String?
  directed     Boolean  @default(true)
  category     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  relations                Relation[]
  translations             RelationTypeTranslation[]
  researchRelations        ResearchRelation[]
  researchFindingProposals ResearchFindingProposal[]
}

model RelationTypeTranslation {
  id             String   @id @default(cuid())
  relationTypeId String
  locale         String
  label          String
  inverseLabel   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  relationType RelationType @relation(fields: [relationTypeId], references: [id], onDelete: Cascade)

  @@unique([relationTypeId, locale])
  @@index([locale])
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entities     EntityTag[]
  translations TagTranslation[]

  @@index([category])
  @@index([isActive])
}

model TagTranslation {
  id          String   @id @default(cuid())
  tagId       String
  locale      String
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale])
}

model EntityTag {
  entityId  String
  tagId     String
  weight    Float?
  source    String?
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityId, tagId])
  @@index([entityId])
  @@index([tagId])
  @@index([source])
}

model Taxonomy {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terms TaxonomyTerm[]

  @@index([isActive])
}

model TaxonomyTerm {
  id          String   @id @default(cuid())
  taxonomyId  String
  key         String
  label       String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taxonomy        Taxonomy                  @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent          TaxonomyTerm?             @relation("TaxonomyTermHierarchy", fields: [parentId, taxonomyId], references: [id, taxonomyId], onDelete: Restrict)
  children        TaxonomyTerm[]            @relation("TaxonomyTermHierarchy")
  translations    TaxonomyTermTranslation[]
  classifications EntityClassification[]

  @@unique([taxonomyId, key])
  @@unique([id, taxonomyId])
  @@index([taxonomyId, sortOrder])
  @@index([parentId])
  @@index([isActive])
}

model TaxonomyTermTranslation {
  id          String   @id @default(cuid())
  termId      String
  locale      String
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  term TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
  @@index([locale])
}

model EntityClassification {
  entityId   String
  termId     String
  confidence Float?
  source     String?
  createdAt  DateTime @default(now())

  entity Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  term   TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([entityId, termId])
  @@index([termId])
  @@index([source])
}

model AttributeDefinition {
  id          String             @id @default(cuid())
  key         String             @unique
  label       String
  description String?
  valueType   AttributeValueType
  // Controls simultaneous published values; competing drafts remain valid assertions.
  isMultiple  Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  attributes   EntityAttribute[]
  translations AttributeDefinitionTranslation[]

  @@index([isActive])
}

model AttributeDefinitionTranslation {
  id           String   @id @default(cuid())
  definitionId String
  locale       String
  label        String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, locale])
  @@index([locale])
}

model EntityAttribute {
  id            String                   @id @default(cuid())
  entityId      String
  definitionId  String
  locale        String                   @default("und")
  valueText     String?
  valueNumber   Float?
  valueBoolean  Boolean?
  valueDate     DateTime?
  valueYear     Int?
  valueJson     Json?
  status        KnowledgeAssertionStatus @default(DRAFT)
  confidence    Float?
  validFromYear Int?
  validToYear   Int?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  entity     Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  citations  Citation[]          @relation("CitationEntityAttribute")

  @@index([entityId, definitionId])
  @@index([definitionId])
  @@index([status])
}

model Citation {
  id                 String         @id @default(cuid())
  sourceId           String
  entityId           String?
  relationId         String?
  entityAttributeId  String?
  researchEvidenceId String?
  stance             CitationStance @default(MENTIONS)
  locator            String?
  quote              String?
  note               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  source           Source                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  entity           Entity?               @relation("CitationEntity", fields: [entityId], references: [id], onDelete: Cascade)
  relation         Relation?             @relation("CitationRelation", fields: [relationId], references: [id], onDelete: Cascade)
  entityAttribute  EntityAttribute?      @relation("CitationEntityAttribute", fields: [entityAttributeId], references: [id], onDelete: Cascade)
  researchEvidence ResearchEvidence?     @relation(fields: [researchEvidenceId], references: [id], onDelete: SetNull)
  translations     CitationTranslation[]

  @@index([sourceId])
  @@index([entityId])
  @@index([relationId])
  @@index([entityAttributeId])
  @@index([researchEvidenceId])
}

model CitationTranslation {
  id         String   @id @default(cuid())
  citationId String
  locale     String
  quote      String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  citation Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([citationId, locale])
  @@index([locale])
}

model Media {
  id                 String          @id @default(cuid())
  url                String
  kind               MediaKind       @default(IMAGE)
  originType         MediaOriginType @default(EXTERNAL_URL)
  derivedFromMediaId String?

  canonicalUrl     String?
  displayUrl       String?
  sourcePageUrl    String?
  storageKey       String?
  originalFilename String?
  fileSize         Int?
  mimeType         String?
  width            Int?
  height           Int?
  focalX           Float?
  focalY           Float?
  isVector         Boolean          @default(false)
  provider         MediaProvider    @default(UNKNOWN)
  qualityTier      MediaQualityTier @default(MEDIUM)

  alt     String?
  source  String? // where it comes from (page/museum/etc)
  photoBy String? // photographer
  license String? // license type

  createdAt DateTime @default(now())

  derivedFromMedia Media?        @relation("MediaDerivation", fields: [derivedFromMediaId], references: [id])
  derivedAssets    Media[]       @relation("MediaDerivation")
  entities         EntityMedia[]
  collectionCovers Collection[]  @relation("CollectionCoverMedia")
  homeDeckCovers   HomeDeck[]    @relation("HomeDeckCoverMedia")

  @@index([derivedFromMediaId])
}

model EntityMedia {
  id             String            @id @default(cuid())
  entityId       String
  mediaId        String
  role           MediaRole         @default(PRIMARY_LEGACY)
  sortOrder      Int               @default(0)
  isPrimary      Boolean           @default(false)
  displayMode    MediaDisplayMode?
  focalX         Float?
  focalY         Float?
  cropExplorer3d Json?
  cropList       Json?
  cropDetail     Json?
  cropPreview    Json?

  entity Entity @relation(fields: [entityId], references: [id])
  media  Media  @relation(fields: [mediaId], references: [id])

  @@index([entityId])
  @@index([mediaId])
  @@index([entityId, role, sortOrder])
  @@index([entityId, isPrimary])
}

model Source {
  id        String     @id @default(cuid())
  type      SourceType
  author    String?
  title     String
  publisher String?
  year      Int?
  url       String?

  createdAt DateTime @default(now())

  refs         SourceRef[]
  translations SourceTranslation[]
  citations    Citation[]

  researchProjects ResearchProjectSource[]
  researchEvidence ResearchEvidence[]
  researchJobs     ResearchJob[]
  libraryMaterials LibraryMaterial[]
}

model SourceTranslation {
  id        String   @id @default(cuid())
  sourceId  String
  locale    String
  title     String
  author    String?
  publisher String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, locale])
  @@index([locale])
}

model SourceRef {
  id       String @id @default(cuid())
  entityId String
  sourceId String

  page  String?
  quote String?
  note  String?

  entity       Entity                 @relation(fields: [entityId], references: [id])
  source       Source                 @relation(fields: [sourceId], references: [id])
  translations SourceRefTranslation[]

  @@index([entityId])
  @@index([sourceId])
}

model SourceRefTranslation {
  id          String   @id @default(cuid())
  sourceRefId String
  locale      String
  quote       String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sourceRef SourceRef @relation(fields: [sourceRefId], references: [id], onDelete: Cascade)

  @@unique([sourceRefId, locale])
  @@index([locale])
}

model ResearchProject {
  id           String                @id @default(cuid())
  title        String
  ownerId      String
  archivedAt   DateTime?
  archivedById String?
  objective    String
  scope        String?
  status       ResearchProjectStatus @default(ACTIVE)
  lastActiveAt DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  sources          ResearchProjectSource[]
  evidence         ResearchEvidence[]
  legacyFindings   ResearchFinding[] // Legacy compatibility; never queried by active Research flows
  decisions        ResearchDecision[]
  outlineSections  ResearchOutlineSection[]
  drafts           ResearchDraft[]
  jobs             ResearchJob[]
  aiExecutions     AIExecution[]
  findingProposals ResearchFindingProposal[]
  claims           ResearchClaim[]
  entities         ResearchEntity[]
  libraryMaterials ResearchLibraryMaterial[]
  relations        ResearchRelation[]

  owner      User  @relation("ResearchProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  archivedBy User? @relation("ResearchProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([ownerId, lastActiveAt])
  @@index([archivedById])
  @@index([status, lastActiveAt])
  @@index([updatedAt])
}

model LibraryMaterial {
  id        String              @id @default(cuid())
  sourceId  String?
  kind      LibraryMaterialKind
  title     String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  source   Source?                   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versions LibraryMaterialVersion[]
  research ResearchLibraryMaterial[]

  @@index([sourceId])
}

model LibraryMaterialVersion {
  id           String                       @id @default(cuid())
  materialId   String
  version      Int
  status       LibraryMaterialVersionStatus @default(READY)
  content      String?
  url          String?
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  contentHash  String?
  createdAt    DateTime                     @default(now())

  material LibraryMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  excerpts LibraryExcerpt[]
  researchJobs ResearchJob[]
  sectionReferences ResearchOutlineSectionMaterial[]

  @@unique([materialId, version])
  @@index([materialId, createdAt])
}

model LibraryExcerpt {
  id                String   @id @default(cuid())
  materialVersionId String
  locator           String
  text              String
  fingerprint       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  materialVersion   LibraryMaterialVersion          @relation(fields: [materialVersionId], references: [id], onDelete: Cascade)
  evidence          ResearchEvidence[]
  sectionReferences ResearchOutlineSectionExcerpt[]

  @@unique([materialVersionId, fingerprint])
  @@index([materialVersionId])
}

model ResearchLibraryMaterial {
  projectId  String
  materialId String
  createdAt  DateTime @default(now())

  project  ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([projectId, materialId])
  @@index([materialId])
}

model ResearchOutlineSection {
  id              String                       @id @default(cuid())
  projectId       String
  parentSectionId String?
  title           String
  status          ResearchOutlineSectionStatus @default(NOT_STARTED)
  objective       String?
  notes           String?
  sortOrder       Int
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  project  ResearchProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ResearchOutlineSection?  @relation("ResearchOutlineSectionHierarchy", fields: [parentSectionId], references: [id], onDelete: Cascade)
  children ResearchOutlineSection[] @relation("ResearchOutlineSectionHierarchy")

  questions         ResearchQuestion[]
  excerptReferences ResearchOutlineSectionExcerpt[]
  materialReferences ResearchOutlineSectionMaterial[]
  drafts             ResearchDraft[]

  @@index([projectId, parentSectionId, sortOrder])
  @@index([parentSectionId])
}

model ResearchDraft {
  id                String    @id @default(cuid())
  projectId         String
  sectionId         String
  title             String?
  currentRevisionId String?   @unique
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project         ResearchProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section         ResearchOutlineSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  revisions       ResearchDraftRevision[] @relation("ResearchDraftRevisions")
  currentRevision ResearchDraftRevision?  @relation("ResearchDraftCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)

  @@index([projectId, sectionId, updatedAt])
  @@index([sectionId, archivedAt])
}

model ResearchDraftRevision {
  id        String   @id @default(cuid())
  draftId   String
  authorId  String
  number    Int
  content   String
  createdAt DateTime @default(now())

  draft      ResearchDraft  @relation("ResearchDraftRevisions", fields: [draftId], references: [id], onDelete: Cascade)
  currentFor ResearchDraft? @relation("ResearchDraftCurrentRevision")
  author     User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([draftId, number])
  @@index([draftId, createdAt])
  @@index([authorId])
}

model ResearchQuestion {
  id        String   @id @default(cuid())
  sectionId String
  text      String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section ResearchOutlineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sortOrder])
}

model ResearchProjectSource {
  projectId String
  sourceId  String
  note      String?
  createdAt DateTime @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([projectId, sourceId])
  @@index([sourceId])
}

model ResearchEvidence {
  id               String   @id @default(cuid())
  projectId        String
  sourceId         String
  libraryExcerptId String?
  sourceVersion    String
  locator          String
  quote            String?
  context          String?
  note             String?
  fingerprint      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          ResearchProject                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           Source                            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  libraryExcerpt   LibraryExcerpt?                   @relation(fields: [libraryExcerptId], references: [id], onDelete: Restrict)
  legacyFindings   ResearchFindingEvidence[] // Legacy compatibility
  findingProposals ResearchFindingProposalEvidence[]
  claims           ResearchClaimEvidence[]
  citations        Citation[]
  entityEvidence   ResearchEntityEvidence[]

  @@unique([projectId, sourceId, fingerprint])
  @@index([projectId])
  @@index([sourceId])
  @@index([libraryExcerptId])
}

model ResearchEntity {
  id                String                      @id @default(cuid())
  projectId         String
  kind              KnowledgeEntityKind
  title             String
  aliases           Json?
  summary           String?
  confidence        Float?
  mentionCount      Int                         @default(0)
  canonicalEntityId String?
  reviewState       ResearchProposalReviewState @default(PENDING)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  project         ResearchProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canonicalEntity Entity?                  @relation(fields: [canonicalEntityId], references: [id], onDelete: SetNull)
  evidence        ResearchEntityEvidence[]
  outgoing        ResearchRelation[]       @relation("ResearchRelationFrom")
  incoming        ResearchRelation[]       @relation("ResearchRelationTo")

  @@index([projectId, reviewState])
  @@index([canonicalEntityId])
}

model ResearchEntityEvidence {
  entityId   String
  evidenceId String
  entity     ResearchEntity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  evidence   ResearchEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([entityId, evidenceId])
  @@index([evidenceId])
}

model ResearchRelation {
  id             String                      @id @default(cuid())
  projectId      String
  fromEntityId   String
  toEntityId     String
  relationTypeId String?
  explanation    String?
  confidence     Float?
  reviewState    ResearchProposalReviewState @default(PENDING)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  project      ResearchProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromEntity   ResearchEntity          @relation("ResearchRelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     ResearchEntity          @relation("ResearchRelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  relationType RelationType?           @relation(fields: [relationTypeId], references: [id], onDelete: SetNull)
  claims       ResearchRelationClaim[]

  @@index([projectId, reviewState])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationTypeId])
}

model ResearchRelationClaim {
  relationId String
  claimId    String

  relation ResearchRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  claim    ResearchClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([relationId, claimId])
  @@index([claimId])
}

/// Legacy compatibility only: migrated to ResearchClaim and never written or exposed by active flows.
model ResearchFinding {
  id               String                @id @default(cuid())
  projectId        String
  promotedEntityId String?
  title            String
  kind             String?
  summary          String?
  status           ResearchFindingStatus @default(PROPOSED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  project            ResearchProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promotedEntity     Entity?                   @relation("ResearchFindingPromotedEntity", fields: [promotedEntityId], references: [id], onDelete: SetNull)
  evidence           ResearchFindingEvidence[]
  decisions          ResearchDecision[]
  convertedProposals ResearchFindingProposal[] @relation("ConvertedFindingProposal")

  @@index([projectId, status])
  @@index([promotedEntityId])
  @@index([updatedAt])
}

model ResearchFindingEvidence {
  findingId  String
  evidenceId String

  finding  ResearchFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence ResearchEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([findingId, evidenceId])
  @@index([evidenceId])
}

model ResearchDecision {
  id        String                 @id @default(cuid())
  projectId String
  findingId String? // Legacy compatibility only
  claimId   String?
  actorId   String?
  action    ResearchDecisionAction
  note      String?
  createdAt DateTime               @default(now())

  project ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  finding ResearchFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  claim   ResearchClaim?   @relation(fields: [claimId], references: [id], onDelete: SetNull)
  actor   User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([findingId])
  @@index([claimId])
  @@index([actorId])
}

model ResearchJob {
  id               String            @id @default(cuid())
  projectId        String
  sourceId         String?
  materialVersionId String?
  type             ResearchJobType
  status           ResearchJobStatus @default(QUEUED)
  inputFingerprint String
  attempts         Int               @default(0)
  maxAttempts      Int               @default(3)
  lastError        String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project          ResearchProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source           Source?                   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  materialVersion  LibraryMaterialVersion?    @relation(fields: [materialVersionId], references: [id], onDelete: SetNull)
  aiExecutions     AIExecution[]
  findingProposals ResearchFindingProposal[]

  @@unique([projectId, type, inputFingerprint])
  @@index([projectId, status])
  @@index([sourceId])
  @@index([materialVersionId])
}

model AIExecution {
  id              String   @id @default(cuid())
  jobId           String?
  projectId       String?
  task            String
  provider        String
  model           String
  providerVersion String?
  input           Json
  output          Json?
  durationMs      Int?
  costCents       Int?
  error           String?
  createdAt       DateTime @default(now())

  job              ResearchJob?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  project          ResearchProject?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findingProposals ResearchFindingProposal[]

  @@index([jobId])
  @@index([projectId, createdAt])
  @@index([task, createdAt])
}

model ResearchFindingProposal {
  id                 String                      @id @default(cuid())
  projectId          String
  jobId              String?
  aiExecutionId      String
  convertedFindingId String? // Legacy compatibility only
  convertedClaimId   String?
  type               ResearchFindingProposalType @default(LEGACY)
  proposalKey        String?
  resultFingerprint  String?
  title              String
  summary            String?
  kind               String?
  claimKind          ResearchClaimKind?
  entityKind         KnowledgeEntityKind?
  relationFromKey    String?
  relationToKey      String?
  relationTypeId     String?
  explanation        String?
  reviewState        ResearchProposalReviewState @default(PENDING)
  createdAt          DateTime                    @default(now())

  project          ResearchProject                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job              ResearchJob?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  aiExecution      AIExecution                       @relation(fields: [aiExecutionId], references: [id], onDelete: Cascade)
  relationType     RelationType?                     @relation(fields: [relationTypeId], references: [id], onDelete: SetNull)
  convertedFinding ResearchFinding?                  @relation("ConvertedFindingProposal", fields: [convertedFindingId], references: [id], onDelete: SetNull)
  convertedClaim   ResearchClaim?                    @relation("ConvertedClaimProposal", fields: [convertedClaimId], references: [id], onDelete: SetNull)
  evidence         ResearchFindingProposalEvidence[]

  @@index([projectId, reviewState])
  @@index([jobId])
  @@index([aiExecutionId])
  @@index([relationTypeId])
  @@index([convertedClaimId])
  @@index([convertedFindingId])
}

model ResearchFindingProposalEvidence {
  proposalId String
  evidenceId String

  proposal ResearchFindingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  evidence ResearchEvidence        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([proposalId, evidenceId])
  @@index([evidenceId])
}

model ResearchClaim {
  id             String              @id @default(cuid())
  projectId      String
  kind           ResearchClaimKind
  title          String
  summary        String?
  subjectClaimId String?
  objectClaimId  String?
  status         ResearchClaimStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project            ResearchProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence           ResearchClaimEvidence[]
  subject            ResearchClaim?            @relation("ResearchClaimSubject", fields: [subjectClaimId], references: [id], onDelete: SetNull)
  subjectOf          ResearchClaim[]           @relation("ResearchClaimSubject")
  object             ResearchClaim?            @relation("ResearchClaimObject", fields: [objectClaimId], references: [id], onDelete: SetNull)
  objectOf           ResearchClaim[]           @relation("ResearchClaimObject")
  relations          ResearchRelationClaim[]
  decisions          ResearchDecision[]
  convertedProposals ResearchFindingProposal[] @relation("ConvertedClaimProposal")

  @@index([projectId, kind])
  @@index([projectId, status])
  @@index([subjectClaimId])
  @@index([objectClaimId])
  @@index([updatedAt])
}

model ResearchClaimEvidence {
  claimId    String
  evidenceId String

  claim    ResearchClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence ResearchEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([claimId, evidenceId])
  @@index([evidenceId])
}

model CuratorNote {
  id        String   @id @default(cuid())
  entityId  String
  body      String
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model Contributor {
  id       String @id @default(cuid())
  entityId String

  name String
  role String // curator | advisor | restorer | composer | ...
  note String?

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model ArtworkDetails {
  entityId     String  @id
  authorNation String?

  technique  String?
  materials  String?
  dimensions String?

  location   String? // museum/gallery/current location
  collection String?
  state      String? // restored, destroyed, unfinished...

  entity       Entity                      @relation(fields: [entityId], references: [id])
  translations ArtworkDetailsTranslation[]
}

model ArtistDetails {
  entityId String @id

  country   String?
  city      String?
  birthYear Int?
  deathYear Int?

  disciplines String? // simple string list for now
  bioShort    String?
  links       String? // simple string list for now

  entity       Entity                     @relation(fields: [entityId], references: [id])
  translations ArtistDetailsTranslation[]
}

model ConceptDetails {
  entityId   String  @id
  definition String?

  entity       Entity                      @relation(fields: [entityId], references: [id])
  translations ConceptDetailsTranslation[]
}

model PeriodDetails {
  entityId   String  @id
  definition String?

  entity       Entity                     @relation(fields: [entityId], references: [id])
  translations PeriodDetailsTranslation[]
}

model ArtworkDetailsTranslation {
  id           String   @id @default(cuid())
  entityId     String
  locale       String
  authorNation String?
  technique    String?
  materials    String?
  dimensions   String?
  location     String?
  collection   String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  details ArtworkDetails @relation(fields: [entityId], references: [entityId], onDelete: Cascade)

