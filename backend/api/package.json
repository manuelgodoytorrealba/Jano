{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.4 <11"
  },
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seeds.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "seed:system": "node dist/prisma/seed-system.js",
    "seed:foundational": "node dist/prisma/seed-foundational.js",
    "seed:system:ts": "node -r ts-node/register prisma/seed-system.ts",
    "seed:foundational:ts": "node -r ts-node/register prisma/seed-foundational.ts",
    "foundational:validate": "node -r ts-node/register prisma/foundational/validate-catalog.ts",
    "foundational:report": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/foundational-report.ts",
    "foundational:search-benchmark": "node -r ts-node/register scripts/foundational-search-benchmark.ts",
    "foundational:discovery-benchmark": "node -r ts-node/register scripts/foundational-discovery-benchmark.ts",
    "foundational:editorial-inventory": "node -r ts-node/register scripts/foundational-editorial-inventory.ts",
    "foundational:editorial-essay-plan": "node -r ts-node/register scripts/foundational-editorial-essay-plan.ts",
    "foundational:editorial-pilot": "node -r ts-node/register scripts/import-foundational-editorial-pilot.ts",
    "foundational:editorial-complete": "node -r ts-node/register scripts/complete-foundational-editorial.ts",
    "foundational:editorial-complete:apply": "node -r ts-node/register scripts/complete-foundational-editorial.ts --apply",
    "foundational:editorial-generate": "node -r ts-node/register scripts/complete-foundational-editorial.ts --generate",
    "foundational:editorial-generate:apply": "node -r ts-node/register scripts/complete-foundational-editorial.ts --generate --apply",
    "foundational:editorial-quality-benchmark": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/editorial-quality-benchmark.ts",
    "foundational:editorial-quality-benchmark:generate": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/editorial-quality-benchmark.ts --generate",
    "foundational:source-coverage-audit": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/source-coverage-audit.ts",
    "foundational:controlled-source-pilot": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/controlled-source-ingestion-pilot.ts",
    "foundational:semantic-evidence-audit": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-audit.ts",
    "foundational:semantic-evidence-classifier-eval": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-classifier-eval.ts",
    "foundational:semantic-evidence-holdout-eval": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-holdout-eval.ts",
    "foundational:semantic-evidence-pilot3-predictions": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot3-predictions.ts",
    "foundational:semantic-evidence-pilot3-gold": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot3-gold-eval.ts",
    "foundational:semantic-evidence-pilot3-workflow": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot3-workflow.ts",
    "foundational:semantic-evidence-pilot3-idempotency": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot3-idempotency.ts",
    "foundational:semantic-evidence-pilot4-predictions": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot4-predictions.ts",
    "foundational:semantic-evidence-pilot4-gold": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/semantic-evidence-pilot4-gold-eval.ts",
    "foundational:hybrid-semantic-evidence-eval": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/hybrid-semantic-evidence-eval.ts",
    "foundational:visual-validate": "node dist/scripts/foundational-visual-validate.js",
    "foundational:media-fallbacks": "node -r ts-node/register scripts/complete-foundational-media-fallbacks.ts",
    "foundational:media-fallbacks:apply": "node -r ts-node/register scripts/complete-foundational-media-fallbacks.ts --apply",
    "foundational:specific-media": "node -r ts-node/register scripts/correct-foundational-specific-media.ts",
    "foundational:specific-media:apply": "node -r ts-node/register scripts/correct-foundational-specific-media.ts --apply",
    "foundational:visual-pilot": "node dist/scripts/import-foundational-visual-pilot.js",
    "foundational:visual-pilot:dry-run": "node dist/scripts/import-foundational-visual-pilot.js --dry-run",
    "foundational:local-visual-pilot": "node dist/scripts/import-foundational-local-visual-pilot.js",
    "foundational:local-visual-pilot:apply": "node dist/scripts/import-foundational-local-visual-pilot.js --apply",
    "knowledge:graph-health": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/knowledge-graph-health.ts",
    "foundational:idempotency": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/foundational-idempotency.ts",
    "db:reset:development": "node -r ts-node/register scripts/reset-development.ts",
    "prisma:reset": "prisma migrate reset",
    "studio": "prisma studio --port 5555 --browser none",
    "db:empty:prod": "node scripts/empty-production-db.js",
    "admin:info": "node scripts/admin-info.js",
    "research:benchmark": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/research-benchmark.ts",
    "research:publication-demo": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/research-publication-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.19.0",
    "prisma": "^7.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
