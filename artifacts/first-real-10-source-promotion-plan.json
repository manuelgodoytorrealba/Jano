    },
    {
      "reviewItemId": "first-real-10-16",
      "researchEvidenceId": "cmthi6riy0002wlfp50rvoufk",
      "canonicalEntityId": "cmsumr74z003rodfppy1l9peb",
      "proposition": "El arte conceptual implica que toda la planificación y las decisiones se realizan antes de la ejecución, que es una cuestión rutinaria.",
      "supportQuote": "When an artist uses a conceptual form of art, it means that all of the planning and decisions are made beforehand and the execution is a perfunctory affair.",
      "source": {
        "sourceId": "cmt4kt35k0008vwfpbo8yt2e3",
        "locator": "paragraph-6",
        "materialVersionId": "cmthgbhsw000cuyfpqmury2gt",
        "excerptId": "cmthgbu9j000iuyfp06gvw02o"
      },
      "dimension": "PRACTICE_OR_METHOD",
      "knowledgeStatus": "NEW_KNOWLEDGE",
      "promotionTarget": "ENTITY_KNOWLEDGE",
      "proposedAction": "CREATE_CANONICAL_KNOWLEDGE"
    },
    {
      "reviewItemId": "first-real-10-18",
      "researchEvidenceId": "cmthi6rj20003wlfpu9u4c0qu",
      "canonicalEntityId": "cmsumr74z003rodfppy1l9peb",
      "proposition": "El arte conceptual utiliza cualquier material y forma apropiada para transmitir una idea, lo que puede variar desde un performance hasta una descripción escrita.",
      "supportQuote": "This is because, unlike a painter or sculptor who will think about how best they can express their idea using paint or sculptural materials and techniques, a conceptual artist uses whatever materials and whatever form is most appropriate to putting their idea across – this could be anything from a performance to a written description.",
