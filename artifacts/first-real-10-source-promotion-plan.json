    {
      "reviewItemId": "first-real-10-15",
      "researchEvidenceId": "cmthi6riu0001wlfpofes756e",
      "canonicalEntityId": "cmsumr74z003rodfppy1l9peb",
      "proposition": "El término arte conceptual fue utilizado por primera vez en 1967 en un artículo escrito por Sol LeWitt para referirse a este movimiento distinto.",
      "supportQuote": "The term conceptual art was first used to reference this distinct movement in an article written by Sol LeWitt in 1967: In conceptual art the idea or concept is the most important aspect of the work.",
      "source": {
        "sourceId": "cmt4kt35k0008vwfpbo8yt2e3",
        "locator": "paragraph-5",
        "materialVersionId": "cmthgbhsw000cuyfpqmury2gt",
