[Unit]
Description=Create a coordinated incremental JANO snapshot

[Service]
Type=oneshot
ExecStart=/bin/bash /srv/apps/jano/infra/scripts/periodic-backup.sh
ExecStopPost=/bin/bash /srv/apps/jano/infra/scripts/periodic-recover.sh
TimeoutStartSec=45min
TimeoutStopSec=5min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
