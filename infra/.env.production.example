COMPOSE_PROJECT_NAME=infra

# Existing production volumes. Confirm with: docker volume ls
POSTGRES_VOLUME=infra_jano_pgdata
UPLOADS_VOLUME=infra_backend_uploads

POSTGRES_DB=jano
POSTGRES_USER=jano
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jano:URL_ENCODED_PASSWORD@db:5432/jano?schema=public

JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_TTL_SECONDS=60
FRONTEND_ORIGIN=https://jano.example.com
APP_PUBLIC_URL=https://jano.example.com
MEDIA_PUBLIC_BASE_URL=https://jano.example.com
NG_ALLOWED_HOSTS=jano.example.com
JANO_PUBLIC_URL=https://jano.example.com

MAIL_PROVIDER=resend
MAIL_FROM="JANO <noreply@mail.example.com>"
RESEND_API_KEY=replace-with-resend-api-key

BACKEND_BIND=127.0.0.1
BACKEND_PORT=3000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=4200
ADMINER_PORT=8082

JANO_BACKUP_DIR=/srv/backups/jano
JANO_STATE_DIR=/srv/apps/jano/.deploy
# Optional mounted/off-host destination. The deploy warns when omitted.
# JANO_BACKUP_MIRROR=/mnt/offsite/jano
