COMPOSE_PROJECT_NAME=jano

# UID/GID used by the development backend container for bind-mounted files.
# Run `id -u` and `id -g` on Linux when your account does not use 1000:1000.
LOCAL_UID=1000
LOCAL_GID=1000

FRONTEND_PORT=4211
BACKEND_PORT=3000
POSTGRES_PORT=5432
ADMINER_PORT=8080
PRISMA_STUDIO_PORT=5555

POSTGRES_DB=jano
POSTGRES_USER=jano
POSTGRES_PASSWORD=jano123

FRONTEND_ORIGIN=http://localhost:4200
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-with-a-long-random-secret

# Operations (optional). Metrics return 404 until a token of at least 32 characters is set.
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Editorial generation (optional; benchmark remains dry-run when unset)
AI_PROVIDER=noop
AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Frontend SSR
SSR_API_ORIGIN=http://backend:3000
API_PROXY_TARGET=http://backend:3000
NG_ALLOWED_HOSTS=localhost,127.0.0.1,jano.manuelgodoy.eu
